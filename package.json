{
  "name": "sheetbridge",
  "version": "0.0.1",
  "description": "A unified, type-safe TypeScript library to parse CSV, XLS, and XLSX files to JSON in the browser",
  "license": "MIT",
  "author": "Anirban Deb <your-email@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnirbanDeb0510/sheetbridge.git"
  },
  "homepage": "https://github.com/AnirbanDeb0510/sheetbridge#readme",
  "keywords": [
    "csv",
    "xls",
    "xlsx",
    "excel",
    "parser",
    "json",
    "spreadsheet",
    "browser",
    "typescript"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:browser": "vitest --config vitest.browser.local.config.ts",
    "test:browser:ci": "playwright install chromium && vitest --run --config vitest.browser.config.ts",
    "test:browser:chromium": "vitest --run --config vitest.browser.config.ts",
    "test:browser:clean": "playwright uninstall",
    "test:browser:clean:chromium": "playwright uninstall",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "read-excel-file": "^9.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.14",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^8.55.0",
    "playwright": "^1.59.1",
    "prettier": "^3.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
